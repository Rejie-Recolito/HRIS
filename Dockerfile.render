# Dockerfile tailored for Render (single container: nginx + php-fpm)
# Multi-stage: vendor -> assets -> final

FROM composer:2.6 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install --no-dev --no-interaction --no-progress --prefer-dist --optimize-autoloader

FROM node:18-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --silent --no-audit --no-fund || true
COPY . ./
RUN npm run build || true

FROM php:8.2-fpm-alpine
# system deps
RUN apk add --no-cache bash git icu-dev zlib-dev libzip-dev libpng-dev oniguruma-dev nginx curl
# php extensions
RUN docker-php-ext-install pdo_mysql zip intl

# copy composer from vendor stage
COPY --from=vendor /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html
# copy vendor and built assets
COPY --from=vendor /app/vendor ./vendor
COPY --from=assets /app/public/build ./public/build
# copy app
COPY . .

# Create nginx template config (will be env-substituted at start)
RUN mkdir -p /etc/nginx/conf.d /run/nginx
COPY docker/nginx/default.conf.template /etc/nginx/conf.d/default.conf.template

# adjust permissions
RUN chown -R www-data:www-data /var/www/html
RUN chmod -R 755 /var/www/html/storage /var/www/html/bootstrap/cache || true

EXPOSE 8080

# Entrypoint: substitute PORT into nginx conf and start php-fpm and nginx
CMD ["/bin/sh","-lc","envsubst '$$PORT' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && php-fpm -D && nginx -g 'daemon off;'"]
